# Supabase PostgreSQL Configuration Template
# Copy this file to .env and fill in your project credentials from Supabase Dashboard (Settings -> Database)

# Option A: Supabase Transaction / Session Pooler (Recommended for Cloud/IPv4):
# Example: jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_database_password

# Server Port
SERVER_PORT=8080
